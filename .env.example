# Used by `npm run db:push` (drizzle-kit) and, via .dev.vars'
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE, by local `next dev`/`wrangler dev`.
# The deployed Worker instead reaches Supabase through the Hyperdrive binding in wrangler.jsonc
# (see lib/db/index.ts), which was created with the *direct* connection string per Cloudflare's
# docs (Hyperdrive does its own pooling). Use the Supavisor pooler string here instead — Supabase's
# direct host is IPv6-only, which some local/CI networks can't reach; the pooler is dual-stack.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

TMDB_API_KEY=your_v3_api_key_here
NEXT_PUBLIC_MOVIESAPI_URL=
NEXT_PUBLIC_PRIMESRC_URL=
NEXT_PUBLIC_VIDAPI_URL=
NEXT_PUBLIC_VIDLINK_URL=
NEXT_PUBLIC_MULTIEMBED_URL=
# ad-proxy server
NEXT_PUBLIC_STREAM_PROXY_URL= 